<?xml version="1.0" encoding="utf-8"?>
<!-- 계열(목표) 줄: 누르면 접고 편다 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp">
    <LinearLayout
        android:id="@+id/row_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tile"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/row_chev"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_warn"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_wait"
            android:textColor="@color/widget_warn"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/row_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
